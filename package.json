{
  "name": "dsh-im-global",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Foreign-IM channel set for DeepSeek Harness — Discord / Slack / Matrix in one plugin: durable per-conversation sessions, streaming replies, platform-correct markdown.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "discord",
    "slack",
    "matrix",
    "channel",
    "im",
    "plugin"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./markdown": "./lib/markdown.js",
    "./api": "./lib/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkey-sking/dsh-im-global.git"
  },
  "homepage": "https://github.com/monkey-sking/dsh-im-global#readme",
  "author": "monkey-sking"
}
