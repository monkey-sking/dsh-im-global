{
  "name": "dsh-im-global",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "description": "Global IM channels for DeepSeek Harness — Telegram, Discord, Slack, Mattermost, Zulip and Matrix in one plugin, with a Settings page (add / test / save channels, live reload), per-conversation sessions that survive restarts, and platform-correct markdown.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "discord",
    "slack",
    "matrix",
    "channel",
    "im",
    "plugin"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./markdown": "./lib/format.js",
    "./api": "./lib/discord/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "index.json",
    "icon.svg",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "smoke": "node scripts/smoke-adapters.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-agent": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkey-sking/dsh-im-global.git"
  },
  "homepage": "https://github.com/monkey-sking/dsh-im-global#readme",
  "author": "monkey-sking"
}
